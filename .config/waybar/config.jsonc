{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,

    "modules-left": [
        "custom/logo",
        "hyprland/window",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "tray",
        "cpu",
        "memory",
        "disk",
        "network",
        "wireplumber",
        "backlight",
        "bluetooth",
        "battery",
        "custom/power",
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {
        "*": [1, 2, 3]
    }   
    },

    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip": "false"
    },

    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%"
    },

    "memory": {
        "interval": 2,
        "format": "RAM {}%"
    },

    "disk": {
        "interval": 30,
        "path": "/",
        "format": "DISK {percentage_used}%"
    },

    "network": {
        "interval": 2,
        "format-wifi": "NET {signalStrength}%",
        "format-ethernet": "ETH",
        "format-disconnected": "OFF",
        "tooltip-format": "{ifname} via {gwaddr}"
    },

    "wireplumber": {
        "format": "VOL {volume}% ",
        "format-muted": "MUTED"
    },

    "bluetooth": {
        "format": "BT-ON",
        "format-disabled": "BT-OFF",
        "format-connected": "BT- {num_connections}"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}%",
        "format-charging": "CHR {capacity}%",
        "format-plugged": "AC {capacity}%",
        "tooltip-format": "{timeTo}"
    },

    "tray": {
        "spacing": 6
    },

    "custom/slash": {
        "format": "/",
        "tooltip": false
    },
    "backlight": {
    "device": "intel_backlight",
    "format": "BL {percent}% ",
    "tooltip": false
},
    "hyprland/window": {
    "format": "{class}",          // 只显示应用类名，例如：firefox、kitty、code-oss 等
    "separate-outputs": true      // 可选：每个显示器显示自己焦点窗口的类名
},

    "custom/power": {
    "format": "  ",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/power-menu.sh",

    },

"custom/logo": {
        "format": "  ",
        "tooltip": false,
        "on-click": "wofi &"
    },
}
